{
  "id": "java",
  "version": "1.0.0",
  "name": "Java",
  "description": "Install and configure java for desktop-based development containers.",
  "options": {
    "username": {
      "type": "string",
      "default": "automatic",
      "description": "Existing container user."
    },
    "provider": {
      "type": "string",
      "enum": [
        "openjdk",
        "temurin"
      ],
      "default": "openjdk"
    },
    "version": {
      "type": "string",
      "default": "21"
    },
    "chinaMirror": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "auto",
        "default",
        "china"
      ],
      "default": "auto",
      "description": "Select a source explicitly or detect it from environment and timezone."
    },
    "timezone": {
      "type": "string",
      "default": "",
      "description": "Timezone used for automatic source selection; defaults to TZ or system timezone."
    }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/local/java/current",
    "PATH": "/usr/local/java/current/bin:${PATH}"
  }
}

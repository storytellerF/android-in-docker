#!/usr/bin/env python3
"""Docker command recorder used by the build orchestration tests."""
import json
import os
from pathlib import Path
import sys


def fail(message):
    raise ValueError(message)


def require_file(value):
    if not Path(value).is_file():
        fail(f"expected file to exist: {value}")


def build(args):
    dockerfile = None
    for index, arg in enumerate(args):
        if arg in ("-f", "--file"):
            if index + 1 == len(args):
                fail(f"{arg} requires a value")
            dockerfile = args[index + 1]
        elif arg.startswith("--file="):
            dockerfile = arg.split("=", 1)[1]
    if dockerfile is None:
        fail("docker build command did not include -f/--file")
    require_file(dockerfile)
    print(f"fake docker build: {dockerfile}")


def compose(args):
    files = []
    value_options = {"--project-name", "-p", "--project-directory", "--ansi", "--env-file", "--profile"}
    index = 0
    while index < len(args) and args[index].startswith("-"):
        arg = args[index]
        if arg in ("-f", "--file") or arg in value_options:
            if index + 1 == len(args):
                fail(f"{arg} requires a value")
            if arg in ("-f", "--file"):
                require_file(args[index + 1])
                files.append(args[index + 1])
            index += 2
        elif arg.startswith("--file="):
            value = arg.split("=", 1)[1]
            require_file(value)
            files.append(value)
            index += 1
        else:
            index += 1
    if index == len(args):
        fail("docker compose command is missing")
    command, *rest = args[index:]
    if command in ("up", "down"):
        if not files:
            fail(f"docker compose {command} did not include compose files")
        print(f"fake docker compose {command}")
    elif command == "config":
        print(os.environ["IMAGE_REF"])
    elif command == "port":
        if len(rest) < 2:
            fail("docker compose port requires a service and port")
        port = rest[1]
        ports = {"22": "10022", "4723": "14723", "5901": "15901", "6080": "16080"}
        print(f"0.0.0.0:{ports.get(port, '1' + port)}")
    elif command == "ps":
        print("NAME                SERVICE             STATUS")
        print("android-in-docker   android             running")
    elif command == "version":
        print("Docker Compose version v2.99.0-fake")
    else:
        fail(f"unsupported docker compose command: {command}")


def main(args):
    log_path = Path(os.environ["FAKE_DOCKER_LOG"])
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a") as log:
        log.write(json.dumps(["docker", *args]) + "\n")
    if os.environ.get("FAKE_DOCKER_ENV_LOG"):
        with Path(os.environ["FAKE_DOCKER_ENV_LOG"]).open("a") as log:
            log.write(json.dumps({key: os.environ.get(key) for key in ("IMAGE_REF", "CONTAINER_HOME", "ANDROID_ENV_FILE")}) + "\n")
    if not args:
        fail("docker command is missing")
    command, *rest = args
    if command in ("--version", "version"):
        print("Docker version 99.0.0-fake, build fake")
    elif command == "build":
        build(rest)
    elif command == "buildx" and rest:
        if rest[0] == "build":
            build(rest[1:])
        elif rest[0] == "version":
            print("github.com/docker/buildx v0.99.0-fake")
        else:
            fail(f"unsupported docker buildx command: {rest[0]}")
    elif command == "image" and rest[:1] == ["prune"]:
        print("fake docker image prune")
    elif command == "compose":
        compose(rest)
    elif command == "volume" and rest[:1] == ["create"] and len(rest) > 1:
        print(rest[1])
    else:
        fail(f"unsupported docker command: {' '.join(args)}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (ValueError, KeyError) as error:
        print(f"fake docker: {error}", file=sys.stderr)
        sys.exit(1)
